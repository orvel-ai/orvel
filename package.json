{
  "name": "orvel",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source platform for creating, teaching, evaluating, and deploying AI agents.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@orvel/studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=12.4.2"
  },
  "packageManager": "pnpm@12.4.2",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "20.19.43",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "turbo": "2.11.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
