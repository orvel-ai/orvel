# Optional: required only for agents that use the OpenAI adapter. Keep this server-side.
OPENAI_API_KEY=

# Optional: required only for agents that use the Groq adapter. Keep this server-side.
GROQ_API_KEY=

# Optional: model for Groq's semantic teaching relevance judge.
# GROQ_RELEVANCE_MODEL=openai/gpt-oss-20b

# Optional: Ollama defaults to http://localhost:11434. No API key is required.
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: enables local semantic teaching retrieval via Ollama's /api/embed.
# Pull the selected embedding model yourself; Orvel never downloads it automatically.
# OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Optional: defaults to .orvel/data.json in the Studio directory.
# ORVEL_DATA_PATH=./.orvel/data.json
